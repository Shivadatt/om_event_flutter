rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Dynamic role resolver using safe existence guard
    function getUserRole() {
      return exists(/databases/$(database)/documents/admin/$(request.auth.uid))
        ? get(/databases/$(database)/documents/admin/$(request.auth.uid)).data.get('roleType', get(/databases/$(database)/documents/admin/$(request.auth.uid)).data.get('role', 'admin'))
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'customer')
            : 'customer');
    }

    // Dynamic permission check for granular RBAC permissions (e.g. can_manage_quotes)
    function hasAdminPermission(permissionKey) {
      return exists(/databases/$(database)/documents/admin/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/admin/$(request.auth.uid)).data.get('roleType', '') == 'super_admin' ||
          get(/databases/$(database)/documents/admin/$(request.auth.uid)).data.get('role', '') == 'super_admin' ||
          get(/databases/$(database)/documents/admin/$(request.auth.uid)).data.get('permissions', {}).get('can_manage_everything', false) == true ||
          get(/databases/$(database)/documents/admin/$(request.auth.uid)).data.get('permissions', {}).get(permissionKey, false) == true
        );
    }

    // Dynamic role-based authorization check for admin or staff
    function isAdminOrStaff() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admin/$(request.auth.uid)) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['admin', 'staff', 'super_admin', 'demo_admin', 'manager']
        ) ||
        request.auth.token.get('role', '') in ['admin', 'staff', 'super_admin', 'demo_admin', 'manager'] ||
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('email', '') in ['admin@omevents.in', 'demo@omevents.in', 'admin@gmail.com', 'omeventsanddecorators@gmail.com']
      );
    }

    // Categories: Read is public, write requires administrative staff
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdminOrStaff();
    }

    // Experiences (Decoration Items): Read is public, write requires administrative staff
    match /items/{itemId} {
      allow read: if true;
      allow write: if isAdminOrStaff();
    }

    // Reviews: Read is public, creation is public, updates require administrative staff
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdminOrStaff();
    }

    // Leads: Creation is public (anonymous inquiries), read/write requires staff access
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdminOrStaff();
    }

    // Customers: Staff/Admin have full management; Authenticated customers can access only their own record; Public denied
    match /customers/{customerId} {
      allow create: if isAdminOrStaff() || (isAuthenticated() && (request.auth.uid == customerId || request.resource.data.auth_uid == request.auth.uid));
      allow read: if isAdminOrStaff() || (
        isAuthenticated() && (
          resource.data.get('auth_uid', '') == request.auth.uid ||
          resource.data.get('email', '') == request.auth.token.email ||
          customerId == request.auth.uid ||
          (request.auth.token.phone_number != null && (customerId == request.auth.token.phone_number || resource.data.get('phone', '') == request.auth.token.phone_number))
        )
      );
      allow update: if isAdminOrStaff() || (
        isAuthenticated() && (
          resource.data.get('auth_uid', '') == request.auth.uid ||
          resource.data.get('email', '') == request.auth.token.email ||
          customerId == request.auth.uid ||
          (request.auth.token.phone_number != null && (customerId == request.auth.token.phone_number || resource.data.get('phone', '') == request.auth.token.phone_number))
        )
      );
      allow delete: if isAdminOrStaff();
    }

    // Customer Profiles: Client Lounge authenticated customer may read/write only their own profile; Admin/staff full access
    match /customer_profiles/{profileId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == profileId || isAdminOrStaff());
    }

    // Quotations: Access control and client field validation rules
    match /quotations/{quotationId} {
      // P0 FIX: Customers can never create a pre-confirmed or completed quotation, nor write admin confirmation fields
      allow create: if isAdminOrStaff() || (
        isAuthenticated() && 
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.status != 'bookingConfirmed' &&
        request.resource.data.status != 'completed' &&
        !request.resource.data.keys().hasAny([
          'confirmedAt', 'confirmedBy', 'confirmedByAdminId',
          'cancellationApprovedAt', 'cancellationApprovedBy'
        ])
      );
      // P1 FIX: Quotations collection is strictly private to Admin/Staff or the authenticated owner.
      // Denies public/unauthenticated reads and collection-wide enumeration.
      allow get: if isAdminOrStaff() || 
                 (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow list: if isAdminOrStaff() || 
                  (isAuthenticated() && resource.data.customerId == request.auth.uid);
      // P0 FIX: Strict customer transition validation.
      // Customers may NEVER set status = bookingConfirmed, completed, or cancelled,
      // and cannot tamper with admin, confirmation, date-locking, or pricing fields.
      allow update: if isAdminOrStaff() || hasAdminPermission('can_manage_quotes') || (
        isAuthenticated() && 
        resource.data.customerId == request.auth.uid && 
        (
          request.resource.data.status == resource.data.status ||
          (
            resource.data.status != 'bookingConfirmed' &&
            request.resource.data.status in ['acceptedByClient', 'rejectedByClient', 'revisionRequested', 'viewed']
          )
        ) &&
        (resource.data.status == 'bookingConfirmed' || request.resource.data.status != 'bookingConfirmed') &&
        request.resource.data.status != 'completed' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updated_at', 'updatedAt', 
          'customerAction', 'customerActionAt', 'customerViewedAt', 
          'revisionReason', 'revisionMessage',
          'acceptedAt', 'acceptedVersion', 'acceptedAmount', 'acceptedBy',
          'acceptedDevice', 'acceptedIp', 'consentTextVersion',
          'cancellation_reason', 'cancellation_requested_at'
        ]) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'confirmedAt', 'confirmedBy', 'confirmedByAdminId',
          'normalized_event_date', 'public_id', 'publicId',
          'cancellationApprovedAt', 'cancellationApprovedBy',
          'cancellationStatus', 'cancellation_status',
          'adminNotes', 'internalNotes', 'operationalNotes',
          'bookingDetails', 'staffAssignment', 'logistics',
          'isFinancialLocked', 'isPermanentlyLocked',
          'depositPaid', 'totalPrice', 'grandTotal', 'subtotal', 'discount',
          'deliveryCharge', 'travelCharge', 'gstPercent', 'gstAmount',
          'eventDate', 'event_date', 'eventTime', 'event_time', 'location',
          'items', 'pdfUrl', 'customerId'
        ])
      );
      allow delete: if isAdminOrStaff();
    }

    // P2 FIX: Atomic date-locks for confirmed bookings.
    // Deterministic key: booked_dates/{YYYY-MM-DD}.
    // Readable publicly for live calendar availability; admin/staff or authenticated session can create/delete locks.
    match /booked_dates/{dateId} {
      allow read: if true;
      allow write: if isAdminOrStaff() || isAuthenticated();
    }

    // P1 FIX: Safe public booking tracker projection (no PII, no listing/enumeration).
    // Document ID matches publicId (e.g. OM-20261010-001).
    match /booking_timelines/{publicId} {
      allow get: if true;
      allow list: if false; // Enumeration / collection listing strictly denied!
      allow write: if isAdminOrStaff() || isAuthenticated();
    }

    // Quotation drafts: Only authenticated users can access their drafts
    match /quotation_drafts/{draftId} {
      allow read, write: if isAuthenticated();
    }

    // Quotation versions: Read for authenticated users or admin/staff; write for admin/staff only.
    match /quotation_versions/{versionId} {
      allow read: if isAuthenticated() || isAdminOrStaff();
      allow write: if isAdminOrStaff();
    }

    // Quotation Messages: Read/write for authenticated users
    match /quotation_messages/{messageId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdminOrStaff();
    }

    // Quotation Attachments: Read/write for authenticated users
    match /quotation_attachments/{attachmentId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdminOrStaff();
    }

    // Bookings & Payments: Access restricted entirely to logged-in admin/staff members
    match /bookings/{bookingId} {
      allow read, write: if isAdminOrStaff();
    }
    
    match /payments/{paymentId} {
      allow read, write: if isAdminOrStaff();
    }

    // Users (Auth mappings): Users can read/write their own profiles; admins can manage all
    match /users/{userId} {
      allow read: if isAuthenticated() &&
        (
          request.auth.uid == userId ||
          isAdminOrStaff()
        );
      allow write: if isAuthenticated() &&
        (
          request.auth.uid == userId ||
          getUserRole() == 'admin'
        );
    }

    // Activity Logs: Write is allowed for authenticated sessions; reading requires admin role
    match /activity_logs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && getUserRole() == 'admin';
    }

    // Admin Activity: Staff and admin audit log records
    match /admin_activity/{activityId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdminOrStaff();
    }

    // Admin Role Mapping
    match /admin/{adminId} {
      allow read: if isAuthenticated() &&
        (
          request.auth.uid == adminId ||
          isAdminOrStaff()
        );

      // Dynamic permission: existing admin/staff can create admin records, or user can self-bootstrap initial record
      allow create: if isAuthenticated() && (
        isAdminOrStaff() ||
        (request.auth.uid == adminId && !exists(/databases/$(database)/documents/admin/$(adminId)))
      );

      allow update, delete: if isAdminOrStaff();
    }

    // =========================================================================
    // CUSTOMER PORTAL COLLECTIONS
    // =========================================================================

    // Helper to verify customer ownership of a resource document
    function isCustomerOwner() {
      return isAuthenticated() && resource.data.customerId == request.auth.uid;
    }
    function isCustomerCreator() {
      return isAuthenticated() && request.resource.data.customerId == request.auth.uid;
    }

    match /customer_profiles/{customerId} {
      allow read, write: if (isAuthenticated() && request.auth.uid == customerId) || isAdminOrStaff();
    }

    match /customer_leads/{leadId} {
      allow read: if isCustomerOwner() || isAdminOrStaff();
      allow create: if isCustomerCreator() || isAdminOrStaff();
      allow update, delete: if isAdminOrStaff();
    }

    match /inquiries/{inquiryId} {
      allow read: if isCustomerOwner() || isAdminOrStaff();
      allow create: if isCustomerCreator() || isAdminOrStaff();
      allow update, delete: if isAdminOrStaff();
    }

    match /customer_quotes/{quoteId} {
      allow read: if isCustomerOwner() || isAdminOrStaff();
      allow update: if isCustomerOwner() || isAdminOrStaff(); // e.g. accept/reject
      allow create, delete: if isAdminOrStaff();
    }

    match /customer_bookings/{bookingId} {
      allow read: if isCustomerOwner() || isAdminOrStaff();
      allow write: if isAdminOrStaff();
    }

    match /customer_payments/{paymentId} {
      allow read: if isCustomerOwner() || isAdminOrStaff();
      allow write: if isAdminOrStaff();
    }

    match /customer_notifications/{notificationId} {
      allow read: if isCustomerOwner() || (isAuthenticated() && (resource.data.customerId == request.auth.uid || resource.data.customerId == '')) || isAdminOrStaff();
      allow update: if isCustomerOwner() || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'is_read', 'read_at', 'readAt'])) || isAdminOrStaff(); // mark as read
      allow create: if isAdminOrStaff() || (
        isAuthenticated() && 
        request.resource.data.customerId == 'admin' && 
        exists(/databases/$(database)/documents/quotations/$(request.resource.data.quotationId)) &&
        get(/databases/$(database)/documents/quotations/$(request.resource.data.quotationId)).data.customerId == request.auth.uid
      );
      allow delete: if isAdminOrStaff();
    }

    match /customer_reviews/{reviewId} {
      allow read: if isCustomerOwner() || isAdminOrStaff();
      allow create: if isCustomerCreator();
      allow update, delete: if isAdminOrStaff();
    }

    match /customer_wishlist/{wishlistId} {
      allow read, update, delete: if isCustomerOwner() || isAdminOrStaff();
      allow create: if isCustomerCreator();
    }

    // ✅ C-4 FIX: Public gallery items contain no PII — read is public.
    // Previously required isCustomerOwner() which blocked unauthenticated visitors.
    match /customer_gallery/{galleryId} {
      allow read: if true;
      allow write: if isAdminOrStaff(); // Only admins upload media
    }

    match /customer_activity/{activityId} {
      allow read: if isCustomerOwner() || isAdminOrStaff();
      allow create: if isAuthenticated();
      allow update, delete: if isAdminOrStaff();
    }

    match /customer_documents/{docId} {
      allow read: if isCustomerOwner() || isAdminOrStaff();
      allow write: if isAdminOrStaff();
    }

    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdminOrStaff();
    }

    match /promotions/{promoId} {
      allow read: if true;
      allow write: if isAdminOrStaff();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdminOrStaff();
    }

    match /customer_notification_preferences/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /support_tickets/{ticketId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isAdminOrStaff();
    }

    // Notification tokens: users can read/write their own token
    match /notification_tokens/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Notification Queue: Read/write for admin and staff
    match /notification_queue/{docId} {
      allow read, write: if isAdminOrStaff();
    }

    // ✅ H-5 FIX: Explicitly permit admin CMS to read/write notification templates.
    // Previously missing — Firestore defaults to deny when no rule matches.
    match /notification_templates/{docId} {
      allow read, write: if isAdminOrStaff();
    }

    // Enterprise Automation Collections
    match /quotation_automation_logs/{logId} {
      allow read: if isAdminOrStaff();
      allow write: if false; // Only written by Server-side SDK
    }

    match /quotation_reminders/{reminderId} {
      allow read: if isAdminOrStaff();
      allow write: if false; // Only written by Server-side SDK
    }

    match /automation_settings/{settingsId} {
      allow read, write: if isAdminOrStaff();
    }

    // App Settings (configuration documents)
    match /settings/{doc} {
      allow read: if isAdminOrStaff() || !(doc in ['notifications', 'feature_flags', 'email_templates', 'sms_templates', 'invoice', 'analytics', 'dashboard']);
      allow write: if isAdminOrStaff();
    }

    // Offers / Promotions
    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdminOrStaff();
    }

    // Customer Notification Preferences
    match /customer_notification_preferences/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdminOrStaff());
    }

    // Customer Wishlist
    match /customer_wishlist/{wishlistId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.customerId || isAdminOrStaff());
      allow create: if isAuthenticated() && (request.auth.uid == request.resource.data.customerId || isAdminOrStaff());
      allow update, delete: if isAuthenticated() && (request.auth.uid == resource.data.customerId || isAdminOrStaff());
    }

    // Scheduled, dead letter, and log collections for notifications
    match /scheduled_notifications/{docId} {
      allow read, write: if isAdminOrStaff();
    }

    match /dead_letter_notifications/{docId} {
      allow read, write: if isAdminOrStaff();
    }

    match /notification_logs/{docId} {
      allow read, write: if isAdminOrStaff();
    }

    // Cron jobs health summary and logs
    match /cron_health_summary/{docId} {
      allow read, write: if isAdminOrStaff();
    }

    match /cron_health_logs/{docId} {
      allow read, write: if isAdminOrStaff();
    }

    // Maintenance jobs and logs
    match /maintenance_jobs/{docId} {
      allow read, write: if isAdminOrStaff();
    }

    match /maintenance_logs/{docId} {
      allow read, write: if isAdminOrStaff();
    }
  }
}
