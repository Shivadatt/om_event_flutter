{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "om-event",
          "appId": "1:443981257323:android:a99b824ca6d4a10b64af2e",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "web": {
        "default": {
          "projectId": "om-event",
          "appId": "1:443981257323:web:845ec22c4774094264af2e",
          "firebaseHosting": {
            "site": "om-event"
          }
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "om-event",
          "configurations": {
            "android": "1:443981257323:android:a99b824ca6d4a10b64af2e",
            "ios": "1:443981257323:ios:78a69a78355ddd9b64af2e",
            "macos": "1:443981257323:ios:78a69a78355ddd9b64af2e",
            "web": "1:443981257323:web:845ec22c4774094264af2e",
            "windows": "1:443981257323:web:5732633aed5100e664af2e"
          }
        }
      }
    }
  },

  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|wasm)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "flutter.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      },
      {
        "source": "/firebase-messaging-sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },

  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}